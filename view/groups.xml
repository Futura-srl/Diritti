    <!-- Gruppo per gestione addebiti/detrazioni   -->
    <record model="ir.module.category" id="Diritti.module_category_human_resources_detractions">
        <field name="name">Detrazioni dipendenti</field>
        <field name="description">Approvals related to HR processes</field>
        <field name="sequence">10</field>
    </record>

    <!-- In Odoo 19 un res.groups non punta piu' direttamente a ir.module.category:
         nel mezzo c'e' res.groups.privilege (gruppo -> privilege -> categoria).
         La categoria sopra resta valida, ma serve il privilege che la referenzia. -->
    <record model="res.groups.privilege" id="res_groups_privilege_hr_detractions">
        <field name="name">Detrazioni dipendenti</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="Diritti.module_category_human_resources_detractions"/>
    </record>

    <record id="hr_detraction_anomalies_group" model="res.groups">
       <field name="name">Hr: Gestione detrazioni</field>
